{
  "spec_id": "lore-questionnaire",
  "version": 1,
  "title": "Discover Your Lore",
  "description": "A playful questionnaire for generating an entertainment-focused digital identity.",
  "locale": "en",
  "status": "active",
  "scoring": {
    "method": "dimension_mean",
    "input_min": 0,
    "input_max": 4,
    "output_min": 0,
    "output_max": 100,
    "rounding": "nearest_integer",
    "missing_dimension": null,
    "minimum_scored_answers": 8,
    "dimensions": [
      "social_energy",
      "curiosity",
      "creativity",
      "spontaneity",
      "reflection",
      "analytical_style",
      "expressiveness",
      "exploration"
    ],
    "notes": [
      "Scores describe patterns in questionnaire responses, not validated personality traits.",
      "Only dimensions explicitly assigned to an answer are included in that dimension's mean.",
      "A missing dimension remains null; do not silently replace it with zero.",
      "Aesthetic, humour, music and communication preferences are used as profile metadata and recommendation signals, not personality scores."
    ]
  },
  "completion_rules": {
    "required_question_count": 24,
    "all_questions_required": true,
    "allow_partial_submission": false,
    "minimum_writing_sample_characters": 100,
    "maximum_writing_sample_characters": 2000,
    "writing_sample_optional": true,
    "writing_sample_requires_explicit_consent": true
  },
  "questions": [
    {
      "id": "q01",
      "category": "social_energy",
      "prompt": "Your friends cancel plans at the last minute. What's your reaction?",
      "type": "single_select",
      "required": true,
      "options": [
        {"id": "q01_a", "label": "Honestly, I'm relieved. Solo time!", "weights": {"social_energy": 0, "reflection": 3}},
        {"id": "q01_b", "label": "I'll find something else to do.", "weights": {"social_energy": 2, "spontaneity": 3, "exploration": 3}},
        {"id": "q01_c", "label": "Let's reschedule. I wanted to see them.", "weights": {"social_energy": 4, "expressiveness": 2}},
        {"id": "q01_d", "label": "Unexpected solo adventure? I'm in.", "weights": {"social_energy": 2, "spontaneity": 4, "exploration": 4}}
      ]
    },
    {
      "id": "q02",
      "category": "social_energy",
      "prompt": "At a party where you barely know anyone, you usually...",
      "type": "single_select",
      "required": true,
