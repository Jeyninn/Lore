        {"id": "q02_c", "label": "Observe the room before joining in.", "weights": {"social_energy": 1, "reflection": 4, "analytical_style": 3}},
        {"id": "q02_d", "label": "Bring the chaos. Make it memorable.", "weights": {"social_energy": 4, "spontaneity": 4, "expressiveness": 4}}
